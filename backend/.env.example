# ============================================================
# Document Summary Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# The app works without a Groq key (falls back to local pipeline),
# but quality will be much better WITH a key.

# ----------------------------------------------------------
# GROQ API KEY (free, no credit card required)
# Sign up at: https://console.groq.com
# After login → API Keys → Create API Key
# ----------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# Optional: override the default model (leave blank to use default)
# GROQ_MODEL=llama-3.3-70b-versatile
